{
  "name": "dsh-links",
  "version": "0.1.0",
  "description": "DSH 手机插件：配对 + 设备管理 + 18640 接入代理 + 手机 API（纯后端，无页面布局注入）",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "package.json",
    "pnpm-lock.yaml",
    "README.md",
    "LICENSE"
  ]
}
