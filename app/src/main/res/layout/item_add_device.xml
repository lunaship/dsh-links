<?xml version="1.0" encoding="utf-8"?>
<!-- 添加设备卡片：虚线边框 + 圆形加号图标 + 标题 + 描述 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/grid_gap_half"
    android:minHeight="@dimen/card_min_height"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_add_card"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/add_icon_size"
        android:layout_height="@dimen/add_icon_size"
        android:background="@drawable/bg_method_icon">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_scan"
            android:tint="@color/ink_text_primary"
            android:contentDescription="@string/method_scan" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_add"
        android:textSize="@dimen/text_add_title"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ink_text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/add_desc"
        android:textSize="@dimen/text_add_desc"
        android:textColor="@color/ink_text_muted" />
</LinearLayout>
