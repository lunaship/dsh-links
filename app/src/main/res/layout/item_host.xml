<?xml version="1.0" encoding="utf-8"?>
<!-- 设备卡片：小显示器图形 + 状态胶囊 / 名称 / 系统信息 / chips / footer / 操作行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/grid_gap_half"
    android:minHeight="@dimen/card_min_height"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/card_padding"
        android:paddingBottom="0dp">

        <ImageView
            android:layout_width="@dimen/glyph_size"
            android:layout_height="@dimen/glyph_size"
            android:src="@drawable/ic_device_glyph"
            android:contentDescription="@string/app_name" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/pill_padding_h"
            android:paddingVertical="@dimen/pill_padding_v"
            android:background="@drawable/bg_pill">

            <View
                android:id="@+id/status_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_pill"
                android:textColor="@color/ink_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/host_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="@dimen/card_padding"
        android:textSize="@dimen/text_device_name"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ink_text_primary"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/device_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="@dimen/card_padding"
        android:textSize="@dimen/text_device_system"
        android:textColor="@color/ink_text_secondary"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:paddingHorizontal="@dimen/card_padding"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/chip_padding_h"
            android:paddingVertical="@dimen/chip_padding_v"
            android:background="@drawable/bg_chip_green"
            android:text="@string/chip_local"
            android:textSize="@dimen/text_chip"
            android:textColor="@color/ink_online" />

        <TextView
            android:id="@+id/chip_endpoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="@dimen/chip_padding_h"
            android:paddingVertical="@dimen/chip_padding_v"
            android:background="@drawable/bg_chip_green"
            android:text="@string/chip_desktop"
            android:textSize="@dimen/text_chip"
            android:textColor="@color/ink_endpoint_desktop" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/host_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingHorizontal="@dimen/card_padding"
        android:textSize="@dimen/text_footer"
        android:textColor="@color/ink_text_muted"
        android:singleLine="true"
        android:ellipsize="middle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        android:background="@color/ink_border_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/card_padding"
        android:orientation="horizontal">

        <!-- 触控容器 48dp（Material 无障碍规范），视觉按钮 40dp -->
        <LinearLayout
            android:id="@+id/action_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/action_touch"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_height"
                android:gravity="center"
                android:background="@drawable/bg_action"
                android:text="@string/action_open"
                android:textSize="@dimen/text_action"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_remove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/action_gap"
            android:minHeight="@dimen/action_touch"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_height"
                android:gravity="center"
                android:background="@drawable/bg_action"
                android:text="@string/action_remove"
                android:textSize="@dimen/text_action"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink_error" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
