<?xml version="1.0" encoding="utf-8"?>
<!--
  DeepHarness launcher — 方案 A：鲸鱼 + Harness 环
  viewport 108×108，Android adaptive icon 主体安全区 72×72（边距 18）。
  鲸鱼以"被驾驭"的姿态呈现：圆胖躯干 + 上翘尾 + 贯穿躯干的 Harness 环。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 鲸鱼躯干：圆胖水滴形，居中略偏左上。 -->
    <path android:pathData="M30,54
                            C30,40 42,30 56,30
                            C72,30 82,40 82,52
                            C82,60 78,66 72,70
                            C66,74 58,76 50,76
                            C40,76 32,70 30,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="30"
                android:endX="82" android:endY="78">
                <item android:offset="0.0" android:color="#FF679EFE"/>
                <item android:offset="1.0" android:color="#FF4176E6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 尾鳍：从躯干右后方向上翘起。 -->
    <path android:pathData="M76,58
                            C82,50 90,44 96,42
                            C92,52 90,60 90,68
                            C84,66 80,64 76,62 Z"
        android:fillColor="#FF679EFE"/>

    <!-- 胸鳍：下方小三角，暗示立体感。 -->
    <path android:pathData="M44,68
                            C48,72 52,74 58,74
                            C54,76 48,76 42,74 Z"
        android:fillColor="#FF4176E6"/>

    <!-- 眼睛：高光小圆点。 -->
    <path android:pathData="M68,50 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#FFD3E2FF"/>
    <path android:pathData="M68.5,49.5 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0"
        android:fillColor="#FF151517"/>

    <!-- Harness 环（挽具）：贯穿躯干中段，深色细线，两端有连接扣。 -->
    <!-- 主环 -->
    <path android:pathData="M22,52
                            C22,46 26,42 32,42
                            L78,42
                            C84,42 88,46 88,52
                            L88,54
                            C88,60 84,64 78,64
                            L32,64
                            C26,64 22,60 22,54 Z
                            M28,52
                            C28,50 30,48 32,48
                            L78,48
                            C80,48 82,50 82,52
                            L82,54
                            C82,56 80,58 78,58
                            L32,58
                            C30,58 28,56 28,54 Z"
        android:fillType="evenOdd"
        android:fillColor="#FF151517"/>

    <!-- 左侧连接扣 -->
    <path android:pathData="M18,52
                            C18,49 20,47 22,47
                            L26,47
                            L26,57
                            L22,57
                            C20,57 18,55 18,52 Z"
        android:fillColor="#FF151517"/>

    <!-- 右侧连接扣 -->
    <path android:pathData="M82,47
                            L86,47
                            C88,47 90,49 90,52
                            C90,55 88,57 86,57
                            L82,57 Z"
        android:fillColor="#FF151517"/>

    <!-- 尾尖高光 -->
    <path android:pathData="M92,46
                            C94,46 96,47 96,49
                            C95,50 93,50 91,49 Z"
        android:fillColor="#FFD3E2FF"/>
</vector>