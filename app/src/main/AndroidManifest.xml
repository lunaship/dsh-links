<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".core.DshApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSH"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">

        <!-- Splash（启动入口） -->
        <activity
            android:name=".devices.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DSH.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DSH 极简原生工作台 -->
        <activity
            android:name=".native.WorkspaceActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 设备管理与配对 -->
        <activity
            android:name=".devices.DevicesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 设置 -->
        <activity
            android:name=".native.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 扫码 -->
        <activity
            android:name=".devices.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 临时：logo 方案 A/C 预览（仅 dev 用，发布前移除） -->
        <activity
            android:name=".devices.LogoPreviewActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
    </application>
</manifest>
