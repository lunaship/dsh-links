# DSH Links Relay - Example Config (combined, single-user layout)
# Copy to /etc/dsh-links-relay/config.toml and adjust.
# All paths must be owned by dsh-relay user, mode 0600 for secrets.
#
# NOTE: this combined layout lets the relay process read the issuer private
# key and admin credentials. For any public deployment use the split layout
# instead: config-control.toml.example + config-relay.toml.example with the
# two-user setup described in deploy/README.md.

client_listen = "0.0.0.0:8443"
agent_listen = "0.0.0.0:8444"
admin_listen = "127.0.0.1:8080"
control_socket = "/run/dsh-links-relay/control.sock"
ipc_auth_token_file = "/etc/dsh-links-relay/ipc.auth"

# TLS for outer layer (public CA, e.g., Let's Encrypt)
tls_cert = "/etc/dsh-links-relay/relay.crt"
tls_key = "/etc/dsh-links-relay/relay.key"
# Hostname the plugin dials (Agent 8444). Used to mint one-paste enroll URIs.
# public_host = "relay.example.com"

# Capability issuer keys (Ed25519, 32 or 64 bytes, base64 or raw)
issuer_private_key = "/etc/dsh-links-relay/issuer.key"
issuer_public_key = "/etc/dsh-links-relay/issuer.pub"

# Route master key: 32 bytes random, base64 or raw, 0600
route_master_key = "/etc/dsh-links-relay/route-master.key"

# Admin token: random 32+ bytes, base64 or plain, 0600
admin_token_file = "/etc/dsh-links-relay/admin.token"
admin_user = "admin"
# Required. Control refuses to start if this is empty or shorter than 12 characters.
# Leave empty on first deploy so startup fails until you set your own secret,
# or run `dsh-links-relay init` which generates a random password.
# Never ship a publicly-known value: the loopback bind is the only thing that
# keeps a guessable password safe.
admin_password = ""

# SQLite database (only control writes)
database = "/var/lib/dsh-links-relay/control.db"

# Limits
max_total_streams = 1000
default_max_streams_per_route = 8
max_conns = 2000
# IPv6 源地址按该前缀长度聚合后参与所有按 IP 的限流与连接计数，
# 防止轮换 /64 内地址绕开 per-IP 预算（0 表示禁用聚合）。
ipv6_prefix_len = 64
bridge_max_lifetime = "30m"
heartbeat_interval = "20s"
agent_dead_after = "65s"
bind_timeout = "10s"

# ---- 阶段二：匿名自助接入（默认关闭，保持邀请制）----
# anonymous_enroll = true
# anonymous_max_hosts_per_device = 2
# anonymous_max_streams_per_route = 2
# anonymous_daily_bytes = 536870912
# capability_ttl = "168h"
# ipv6_prefix_len = 64
