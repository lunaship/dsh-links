[Unit]
Description=DSH Links Relay Data Plane
After=network.target dsh-links-relay-control.service
Requires=dsh-links-relay-control.service

[Service]
Type=simple
# The relay is the internet-facing crash surface: it runs as its own user and
# its config must not reference any control-only secret (issuer private key,
# admin token/password). Expects the layout from deploy/README.md.
User=dsh-relay
Group=dsh-shared
ExecStart=/usr/local/bin/dsh-links-relay relay --config /etc/dsh-links-relay/relay.toml
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=65535
LimitCORE=0
ReadOnlyPaths=/etc/dsh-links-relay
# Read-write, not read-only: even a read-only SQLite connection must maintain
# the -wal/-shm sidecars next to the shared control database.
ReadWritePaths=/var/lib/dsh-links-relay /run/dsh-links-relay
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
