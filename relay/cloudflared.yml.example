# Cloudflare Tunnel 实验性个人部署模板。
#
# 用前：
#   1. cloudflared tunnel create dsh-links，替换 <TUNNEL_ID>。
#   2. cloudflared tunnel route dns dsh-links <你的域名>。
#   3. 替换 credentials-file 与 hostname。
#
# 当前 Android App 不会登录 Cloudflare Access，也不会发送 Access JWT。
# 因此不要在这里设置 originRequest.access.required；设置后 App 会被拒绝。
# 这不等于本服务适合公开发布：请只用于你自己理解并管理的实验性接入。

tunnel: <TUNNEL_ID>
credentials-file: /Users/<你的用户名>/.cloudflared/<TUNNEL_ID>.json

ingress:
  # 只发布 dsh-links 手机接入代理（含 /dsh-link/* 手机 API + SSE 实时流）。
  # 绝不能把 DSH Web 管理台（默认 :3080）一并发布。
  - hostname: dsh.example.com
    service: https://127.0.0.1:18640
    originRequest:
      noTLSVerify: true
  - service: http_status:404
