# OpenShip-only personal lab runtime. The default Dockerfile stays scratch + split UIDs.
# OpenShip cannot apply Compose secrets/read_only/user. Control still inits as root,
# but Relay only mounts the published share (issuer.pub, TLS, IPC) — never Control data.
# Not for internet-facing production; use docker-compose.yml.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dsh-links-relay ./cmd/dsh-links-relay

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/dsh-links-relay /usr/local/bin/dsh-links-relay
COPY docker-entrypoint.openship.sh /usr/local/bin/docker-entrypoint.openship.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.openship.sh
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.openship.sh"]
CMD ["control"]
