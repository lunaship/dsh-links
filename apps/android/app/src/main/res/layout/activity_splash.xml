<?xml version="1.0" encoding="utf-8"?>
<!-- Elegant brand splash: soft field, rounded mark, restrained type -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg">

    <!-- Soft ambient glow behind the mark -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginBottom="36dp"
        android:background="@drawable/splash_glow" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#0DEBF3"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_dsh_mark_orca"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/brand_title"
            android:textSize="26sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/ink_text_primary"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/brand_tagline_short"
            android:textSize="12sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:textColor="@color/ink_text_muted"
            android:includeFontPadding="false"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
