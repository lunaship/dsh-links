<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DSH.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_brand</item>
        <item name="android:colorBackground">@color/splash_field</item>
        <item name="colorPrimary">@color/splash_field</item>
        <item name="colorPrimaryContainer">@color/splash_field</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DSH" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dsh_brand</item>
        <item name="colorOnPrimary">@color/dsh_on_brand</item>
        <item name="colorPrimaryContainer">@color/dsh_bg_secondary</item>
        <item name="colorOnPrimaryContainer">@color/dsh_label_primary</item>
        <item name="colorSecondaryContainer">@color/dsh_bg_secondary</item>
        <item name="colorOnSecondaryContainer">@color/dsh_label_primary</item>
        <item name="android:windowBackground">@color/dsh_bg_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 同名 style 在本 qualifier 下整体生效（不与 values 合并），须自带 Activity 转场 -->
        <item name="android:windowAnimationStyle">@style/DshActivityAnimation</item>
    </style>
</resources>
